# Copy to .env for local development, or set these as real environment
# variables / platform secrets (e.g. `railway variables set`) in production.
# Nothing in this file is a real secret - it's a template.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Postgres connection string. Railway's Postgres plugin injects this
# automatically - you shouldn't need to set it by hand in production.
# Falls back to local SQLite when unset.
DATABASE_URL=

# Email - defaults to the console backend (prints emails, sends nothing) if unset.
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=
DJANGO_DEFAULT_FROM_EMAIL=
